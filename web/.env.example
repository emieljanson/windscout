# Create a Geoapify project, restrict the key to this site's origins, then copy this file to .env.local.
# Vite includes this browser key in the built site, so origin restrictions are the security boundary.
VITE_GEOAPIFY_API_KEY=replace-with-your-geoapify-key

# Use a hosted Stripe Payment Link. Never put a Stripe secret key in a VITE_ variable.
VITE_DONATION_URL=https://donate.stripe.com/6oU14o3Hy1Xg5C02291wY00
